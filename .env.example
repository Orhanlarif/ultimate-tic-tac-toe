# Database (docker-compose maps Postgres to host port 5433)
DATABASE_URL=postgresql://uttt:uttt@localhost:5433/uttt

# Redis (docker-compose maps Redis to host port 6380)
REDIS_URL=redis://localhost:6380

# Auth.js / NextAuth - email + password accounts, no external OAuth provider
AUTH_SECRET=replace-with-long-random-secret
AUTH_URL=http://localhost:3000

# Realtime
REALTIME_URL=http://localhost:3001
REALTIME_JWT_SECRET=replace-with-another-long-random-secret
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000
