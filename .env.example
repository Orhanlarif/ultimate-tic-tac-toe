# Database (docker-compose maps Postgres to host port 5433)
# Production: Neon pooled connection string (…-pooler… neon.tech)
DATABASE_URL=postgresql://uttt:uttt@localhost:5433/uttt

# Redis (local docker-compose only — production realtime does not use Redis)
REDIS_URL=redis://localhost:6380

# Auth.js / NextAuth - email + password accounts, no external OAuth provider
AUTH_SECRET=replace-with-long-random-secret
AUTH_URL=http://localhost:3000

# Realtime
REALTIME_URL=http://localhost:3001
REALTIME_JWT_SECRET=replace-with-another-long-random-secret
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS — must match the public web origin (Vercel URL in production)
CORS_ORIGIN=http://localhost:3000

# --- Production checklist (set in dashboards, not in git) ---
# Neon:     DATABASE_URL
# Render:   DATABASE_URL, REALTIME_JWT_SECRET, CORS_ORIGIN, NODE_ENV=production
# Vercel:   DATABASE_URL, AUTH_SECRET, AUTH_URL, REALTIME_JWT_SECRET,
#           NEXT_PUBLIC_REALTIME_URL, NEXT_PUBLIC_APP_URL
# UptimeRobot: HTTP(S) monitor every 5–10 min → https://<render-host>/health
